<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">angeo_agent_event_listing.angeo_agent_event_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="report">
                <url path="angeo_agents/report/index"/>
                <class>secondary</class>
                <label translate="true">Back to Report</label>
            </button>
        </buttons>
        <spinner>angeo_agent_event_columns</spinner>
        <deps>
            <dep>angeo_agent_event_listing.angeo_agent_event_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="angeo_agent_event_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">event_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Angeo_AgentActivity::events</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="angeo_agent_event_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>event_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <exportButton name="export_button"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="angeo_agent_event_columns">
        <!--
            Required for Export. The export button builds its POST body from
            the selections column (filters, namespace, selected/excluded).
            Without it the body is empty, and the admin ajax setup then drops
            the form_key, so the export fails with "Invalid Form Key".
        -->
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>event_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="event_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Time</label>
            </settings>
        </column>
        <column name="store_id" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Store View</label>
            </settings>
        </column>
        <column name="channel" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Angeo\AgentActivity\Model\Source\Channel"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Channel</label>
            </settings>
        </column>
        <column name="category" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Angeo\AgentActivity\Model\Source\Category"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Category</label>
            </settings>
        </column>
        <column name="agent" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Agent</label>
            </settings>
        </column>
        <column name="operator" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Operator</label>
            </settings>
        </column>
        <column name="operation" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Operation</label>
            </settings>
        </column>
        <column name="status" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">HTTP Status</label>
            </settings>
        </column>
        <column name="verified" component="Magento_Ui/js/grid/columns/select" sortOrder="100">
            <settings>
                <options class="Angeo\AgentActivity\Model\Source\Verified"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">IP Check</label>
            </settings>
        </column>
        <column name="signed" component="Magento_Ui/js/grid/columns/select" sortOrder="110">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Signed</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="duration_ms" sortOrder="120">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Time (ms)</label>
            </settings>
        </column>
        <column name="path" sortOrder="130">
            <settings>
                <filter>text</filter>
                <label translate="true">Path</label>
            </settings>
        </column>
        <column name="ref" sortOrder="140">
            <settings>
                <filter>text</filter>
                <label translate="true">Checkout / Order</label>
            </settings>
        </column>
        <column name="client" sortOrder="142">
            <settings>
                <filter>text</filter>
                <label translate="true">MCP Client</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="client_version" sortOrder="143">
            <settings>
                <filter>text</filter>
                <label translate="true">Client Version</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="protocol" sortOrder="144">
            <settings>
                <filter>text</filter>
                <label translate="true">MCP Protocol</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="rpc_error" component="Magento_Ui/js/grid/columns/select" sortOrder="145">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">JSON-RPC Error</label>
            </settings>
        </column>
        <column name="cache" component="Magento_Ui/js/grid/columns/select" sortOrder="146">
            <settings>
                <options class="Angeo\AgentActivity\Model\Source\CacheState"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Page Cache</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="has_query" component="Magento_Ui/js/grid/columns/select" sortOrder="147">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Query String</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="value" sortOrder="150">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order Total</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
