$deltaHtml = function (?float $delta) use ($escaper): string {
    if ($delta === null) {
        return '<span class="aa-delta aa-delta--none">' . $escaper->escapeHtml(__('no earlier data')) . '</span>';
    }
    $class = $delta > 0 ? 'up' : ($delta < 0 ? 'down' : 'flat');
    $sign = $delta > 0 ? '+' : '';
    return '<span class="aa-delta aa-delta--' . $class . '">'
        . $escaper->escapeHtml($sign . $delta . '% ' . __('vs previous period')) . '</span>';
};
