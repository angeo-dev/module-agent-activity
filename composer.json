{
    "name": "angeo/module-agent-activity",
    "description": "See what AI agents do in your Magento 2 store: UCP, MCP and WebMCP calls, AI crawler and agent page visits, agent-built orders and revenue. Admin report with charts, event log grid, CSV and CLI reports, bot IP verification. No IP addresses stored.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "ai-agents",
        "agentic-commerce",
        "analytics",
        "ucp",
        "mcp",
        "webmcp",
        "ai-crawlers",
        "aeo"
    ],
    "homepage": "https://angeo.dev",
    "support": {
        "issues": "https://github.com/angeo-dev/module-agent-activity/issues",
        "email": "support@angeo.dev"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-json": "*",
        "magento/framework": ">=103.0.6 <104",
        "magento/module-backend": ">=102.0.6 <103",
        "magento/module-checkout": ">=100.4.6 <101",
        "magento/module-config": ">=101.2.6 <102",
        "magento/module-quote": ">=101.2.6 <102",
        "magento/module-reports": ">=100.4.6 <101",
        "magento/module-sales": ">=103.0.6 <104",
        "magento/module-store": ">=101.1.6 <102",
        "magento/module-ui": ">=101.2.6 <102"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^40.0 || ^41.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "suggest": {
        "angeo/module-ucp-checkout": "Agent-built orders are attributed through UCP checkout sessions",
        "angeo/module-webmcp": "1.0.1+ tags WebMCP tool calls so they show up by tool name"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\AgentActivity\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "mage-os/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "php-http/discovery": false
        }
    }
}
