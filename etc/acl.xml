<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Reports::report">
                    <resource id="Angeo_AgentActivity::report" title="Angeo AI Agent Activity" sortOrder="90">
                        <resource id="Angeo_AgentActivity::refresh" title="Refresh Statistics" sortOrder="10"/>
                    </resource>
                    <resource id="Angeo_AgentActivity::events" title="Angeo AI Agent Events" sortOrder="91"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Angeo_AgentActivity::config" title="Angeo AI Agent Activity Section"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
